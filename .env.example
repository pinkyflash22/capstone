APP_NAME=PyroSense
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
BRAND_LOGO_PATH=supabase://branding/logos/logo.png

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_PREVIOUS_KEYS=

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=
SESSION_TABLE=sessions

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=supabase
QUEUE_CONNECTION=sync

GEOAPIFY_KEY=
GEOAPIFY_COUNTRY_CODE=ph
GEOAPIFY_COUNTRY=Philippines
GEOAPIFY_REGION="Ilocos Region"
GEOAPIFY_BOUNDARY_GEOMETRY=geometry_1000
GEOAPIFY_BOUNDARY_SYNC_LIMIT=20

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_URL=
MAIL_EHLO_DOMAIN=
MAIL_LOG_CHANNEL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

SUPABASE_KEY=
SUPABASE_SECRET=
SUPABASE_REGION=
SUPABASE_STORAGE_BUCKET=
SUPABASE_URL=
SUPABASE_ENDPOINT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

AI_PYTHON_BINARY=python
AI_PREDICTION_SCRIPT=capstone-ai/predict_event.py
AI_MODEL_PATH=capstone-ai/fire_model.pkl
AI_MODEL_METADATA_PATH=capstone-ai/fire_model_metadata.json

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL=3600
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_VERIFY_WEBHOOK_SIGNATURE=true
TELNYX_WEBHOOK_TOLERANCE_SECONDS=300
VOICE_CALL_MISSED_AFTER_SECONDS=45
VOICE_CALL_POLL_INTERVAL_MS=2000

RUN_MIGRATIONS=false

VITE_APP_NAME="${APP_NAME}"
