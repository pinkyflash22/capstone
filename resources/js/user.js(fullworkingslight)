        const userMarker = L.marker([lat, lng], { icon: customIcon })
            .addTo(window.usermap)
            .bindPopup('<strong>You are here!</strong><br>Your current location')
            .openPopup();
        
        // Center map on user location with zoom level 15
        window.usermap.setView([lat, lng], 15);
        
        // Add a circle around user location
        L.circle([lat, lng], {
