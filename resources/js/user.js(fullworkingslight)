export async function loadMarkers() {
    // Check if map exists
    if (!window.usermap) {
        console.error('Map not initialized, cannot load markers');
        return;
    }
    
    const usermarkermap = window.mapData.usermark || [];
    const incidentsData = window.incidentsData || [];
    
    console.log('Loading markers:', usermarkermap.length);
    console.log('Incidents data:', incidentsData.length);

    // Clear existing markers from all layers
    if (stationLayerGroup) stationLayerGroup.clearLayers();
    if (incidentLayerGroup) incidentLayerGroup.clearLayers();
    if (hydrantLayerGroup) hydrantLayerGroup.clearLayers();
    if (otherLayerGroup) otherLayerGroup.clearLayers();

    // Create a map to quickly find incident by marker_id
    const incidentByMarkerId = {};
    incidentsData.forEach(incident => {
        if (incident.marker_id) {
            incidentByMarkerId[incident.marker_id] = incident;
        }
    });

    let bounds = L.latLngBounds(); // To auto-fit map to markers
    let markerCount = 0;
    
    usermarkermap.forEach(function(usermark) {
        if (usermark.lat && usermark.lng) {
            markerCount++;
            console.log(`Adding marker: ${usermark.title || 'Marker'} at ${usermark.lat}, ${usermark.lng} - Type: ${usermark.markerCategory_id}`);
            
            // Extend bounds to include this marker
            bounds.extend([usermark.lat, usermark.lng]);
            
            // Check if this marker is an incident
            const incident = incidentByMarkerId[usermark.marker_id];
            
            // Determine icon and layer based on marker type
            let icon;
            let targetLayer;
            
            if (usermark.markerCategory_id == 1) {
                // Fire Station
                icon = getStationIcon();
                targetLayer = stationLayerGroup;
            } 
            else if (usermark.markerCategory_id == 4) {
                // Fire Hydrant
                icon = getHydrantIcon();
                targetLayer = hydrantLayerGroup;
            }
            else if (usermark.markerCategory_id == 2 || incident) {
                // Incident
                const incidentTypeId = incident ? (incident.incident_type_id || 1) : 1;
                icon = getIncidentIcon(incidentTypeId);
                targetLayer = incidentLayerGroup;
            }
            else {
                // Other markers
                icon = getDefaultIcon();
                targetLayer = otherLayerGroup;
            }
            
            // Create popup content
            let popupContent = `
                <div class="flex flex-col gap-2 w-64 max-w-xs">
                    <div class="flex items-center gap-2 border-b pb-2">
                        <i class="fas ${usermark.markerCategory_id == 1 ? 'fa-fire-extinguisher' : (usermark.markerCategory_id == 2 ? 'fa-fire-extinguisher' : (incident ? 'fa-exclamation-triangle' : 'fa-map-marker-alt'))} text-lg" style="color: ${usermark.markerCategory_id == 1 ? '#3b82f6' : (usermark.markerCategory_id == 2 ? '#dc2626' : '#f97316')}"></i>
                        <strong class="text-base font-bold">${usermark.title || 'Marker ' + usermark.marker_id}</strong>
                    </div>
                    <p class="text-sm text-gray-600">${usermark.description || 'No description'}</p>
            `;
            
            // Add incident-specific information if this is an incident
            if (incident) {
                const incidentTypeName = getIncidentTypeName(incident.incident_type_id);
                const statusColors = {
                    'reported': 'bg-yellow-100 text-yellow-800',
                    'responding': 'bg-blue-100 text-blue-800',
                    'resolved': 'bg-green-100 text-green-800',
                    'closed': 'bg-gray-100 text-gray-800'
                };
                const statusColor = statusColors[incident.status] || 'bg-gray-100 text-gray-800';
                
                popupContent += `
                    <div class="bg-red-50 p-3 rounded-lg mt-1">
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <span class="text-xs font-semibold text-gray-500">Type:</span>
                                <p class="text-sm font-bold text-red-600">${incidentTypeName}</p>
                            </div>
                            <div>
                                <span class="text-xs font-semibold text-gray-500">Status:</span>
                                <p class="text-sm"><span class="px-2 py-0.5 rounded-full text-xs font-semibold ${statusColor}">${incident.status || 'Reported'}</span></p>
                            </div>
                        </div>
                        ${incident.alarmdatetime ? `
                        <div class="mt-2">
                            <span class="text-xs font-semibold text-gray-500">Reported:</span>
                            <p class="text-xs">${new Date(incident.alarmdatetime).toLocaleString()}</p>
                        </div>
                        ` : ''}
                    </div>
                `;
            }
            
            // Add image if exists
            if (usermark.image) {
                popupContent += `
                    <div class="w-full h-32 bg-gray-100 flex items-center justify-center border rounded overflow-hidden">
                        <img src="${usermark.image}" class="object-cover w-full h-full" />
                    </div>
                `;
            } else {
                popupContent += `
                    <div class="w-full h-24 bg-gray-100 flex items-center justify-center border rounded">
                        <i class="fas fa-image text-gray-400 text-2xl"></i>
                        <span class="text-gray-400 text-xs ml-2">No image</span>
                    </div>
                `;
            }
            
            // Add action buttons based on marker type
            if (incident && incident.status !== 'resolved') {
                popupContent += `
                    <button id="viewIncident${usermark.marker_id}" 
                        class="mt-2 bg-blue-600 hover:bg-blue-700 text-white text-sm px-3 py-2 rounded-lg transition-colors w-full flex items-center justify-center gap-2">
                        <i class="fas fa-info-circle"></i>
                        View Incident Details
                    </button>
                `;
            } else if (usermark.markerCategory_id == 1) {
                popupContent += `
                    <button id="callStation${usermark.marker_id}" 
                        class="mt-2 bg-green-600 hover:bg-green-700 text-white text-sm px-3 py-2 rounded-lg transition-colors w-full flex items-center justify-center gap-2">
                        <i class="fas fa-phone"></i>
                        Call Station
                    </button>
                `;
            } else {
                popupContent += `
                    <button id="viewDetails${usermark.marker_id}" 
                        class="mt-2 bg-gray-600 hover:bg-gray-700 text-white text-sm px-3 py-2 rounded-lg transition-colors w-full flex items-center justify-center gap-2">
                        <i class="fas fa-info-circle"></i>
                        View Details
                    </button>
                `;
            }
            
            popupContent += `</div>`;
            
            // Create marker and add to appropriate layer group
            const marker = L.marker([usermark.lat, usermark.lng], { icon: icon })
                .bindPopup(popupContent, {
                    minWidth: 250,
                    maxWidth: 300,
                    className: 'custom-popup'
                });
            
            targetLayer.addLayer(marker);
            
            // Add popup event listeners
            marker.on('popupopen', function () {
                setTimeout(() => {
                    const viewBtn = document.getElementById('viewDetails' + usermark.marker_id);
                    const incidentBtn = document.getElementById('viewIncident' + usermark.marker_id);
                    const callBtn = document.getElementById('callStation' + usermark.marker_id);
                    
                    if (viewBtn) {
                        viewBtn.addEventListener('click', function () {
                            showMarkerDetails(usermark, incident);
                        });
                    }
                    
                    if (incidentBtn) {
                        incidentBtn.addEventListener('click', function () {
                            showIncidentDetails(incident);
                        });
                    }
                    
                    if (callBtn) {
                        callBtn.addEventListener('click', function () {
                            window.location.href = `tel:${usermark.contact_number || '911'}`;
                        });
                    }
                }, 100);
            });
        }
    });
    
    // Fit map to show all markers if there are markers
    if (markerCount > 0 && bounds.isValid()) {
        window.usermap.fitBounds(bounds, { padding: [50, 50] });
        console.log(`Map fitted to ${markerCount} markers`);
    } else {
        // Default view if no markers
        window.usermap.setView([15.8222, 120.3297], 13);
    }
    
    console.log(`Total markers loaded: ${markerCount}`);
}

// Function to show marker details
function showMarkerDetails(marker, incident) {
    const details = {
        title: marker.title || 'Marker',
        description: marker.description || 'No description',
        type: marker.markerCategory_id == 1 ? '🚒 Fire Station' : 
               marker.markerCategory_id == 2 ? '💧 Fire Hydrant' :
               marker.markerCategory_id == 3 ? '🔥 Incident' : '📍 Marker',
        coordinates: `${marker.lat}, ${marker.lng}`,
        incident_type: incident ? getIncidentTypeName(incident.incident_type_id) : null,
        status: incident ? incident.status : null
    };
    
    let message = `📍 ${details.title}\n`;
    message += `━━━━━━━━━━━━━━━━━━━━\n`;
    message += `Type: ${details.type}\n`;
    message += `Description: ${details.description}\n`;
    if (details.incident_type) {
        message += `Incident Type: ${details.incident_type}\n`;
        message += `Status: ${details.status}\n`;
    }
    message += `Location: ${details.coordinates}`;
    
    alert(message);
}

// Function to show incident details
function showIncidentDetails(incident) {
    const incidentTypeName = getIncidentTypeName(incident.incident_type_id);
    const date = incident.alarmdatetime ? new Date(incident.alarmdatetime).toLocaleString() : 'Unknown';
    
    let message = `🔥 INCIDENT DETAILS\n`;
    message += `━━━━━━━━━━━━━━━━━━━━\n`;
    message += `Type: ${incidentTypeName}\n`;
    message += `Status: ${incident.status || 'Reported'}\n`;
    message += `Reported: ${date}\n`;
    if (incident.marker && incident.marker.description) {
        message += `Description: ${incident.marker.description}\n`;
    }
    message += `━━━━━━━━━━━━━━━━━━━━\n`;
    message += `If you see this incident, stay safe and follow instructions from authorities.`;
    
    alert(message);
}

