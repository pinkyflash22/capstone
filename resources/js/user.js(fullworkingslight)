            weight: 2
        }).addTo(window.usermap);
        
        console.log('Current location called:', lat, lng);
    };
});

function getCurrentLocation(){
    if (!navigator.geolocation) {
        alert('Geolocation is not supported by your browser');
        return;
    }

    navigator.geolocation.getCurrentPosition(
        (position) => {
            const lat = position.coords.latitude;
            const lng = position.coords.longitude;

            // Set view to user location
            map.setView([lat, lng], 15);

            // Add marker
            L.marker([lat, lng])
                .addTo(map)
                .bindPopup('📍 You are here')
                .openPopup();

            // Optional: accuracy circle
            L.circle([lat, lng], {
                radius: position.coords.accuracy,
            }).addTo(map);

            console.log('User location:', lat, lng);
        },
        (error) => {
            console.error('Error getting location:', error);
        },
        {
            enableHighAccuracy: true,
            timeout: 10000
        }
    );
}

// Get incident type name by ID
function getIncidentTypeName(typeId) {
    const incidentTypes = {
        1: 'Fire',
        2: 'Medical Emergency',
        3: 'Natural Disaster',
        4: 'Accident',
        5: 'Other'
    };
    return incidentTypes[typeId] || 'Incident';
}

// Get icon color based on incident type
function getIncidentColor(incidentTypeId) {
    const colors = {
        1: '#ef4444', // Fire - Red
        2: '#10b981', // Medical - Green
        3: '#f59e0b', // Natural Disaster - Orange
        4: '#8b5cf6', // Accident - Purple
        5: '#6b7280'  // Other - Gray
    };
    return colors[incidentTypeId] || '#ef4444';
}

// Get icon based on incident type
function getIncidentIcon(incidentTypeId) {
    const icons = {
        1: 'fa-fire',           // Fire
        2: 'fa-ambulance',      // Medical
        3: 'fa-tornado',        // Natural Disaster
        4: 'fa-car-crash',      // Accident
        5: 'fa-exclamation-triangle' // Other
    };
    
    const iconClass = icons[incidentTypeId] || 'fa-fire';
    const bgColor = getIncidentColor(incidentTypeId);
    
    return L.divIcon({
        className: 'custom-incident-icon',
        html: `
            <div style="
                width: 32px;
