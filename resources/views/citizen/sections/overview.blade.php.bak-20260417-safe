<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Get incidents data from Laravel
    const incidents = <?php echo json_encode($incidents, 15, 512) ?>;
    
    // Process data for charts
    function processIncidentData() {
        // Incident types distribution
        const typeCounts = {};
        const statusCounts = {};
        const hourlyCounts = Array(24).fill(0);
        const dailyCounts = Array(7).fill(0);
        console.log('incidents:', incidents);
        incidents.forEach(incident => {
            // Count by type
            const type = incident.incident_type.type || 'unknown';
            typeCounts[type] = (typeCounts[type] || 0) + 1;
            
            // Count by status
            const status = incident.incident_status.status || 'unknown';
            statusCounts[status] = (statusCounts[status] || 0) + 1;
            
            // Count by hour
            if (incident.created_at) {
                const date = new Date(incident.created_at);
                const hour = date.getHours();
                hourlyCounts[hour]++;
                
                // Count by day of week
                const day = date.getDay();
                dailyCounts[day]++;
            }
        });
        
        return { typeCounts, statusCounts, hourlyCounts, dailyCounts };
    }
    
    const { typeCounts, statusCounts, hourlyCounts, dailyCounts } = processIncidentData();
    
    // Colors for charts
    const colors = [
        '#f97316', '#3b82f6', '#22c55e', '#ef4444', '#8b5cf6', 
        '#ec4899', '#14b8a6', '#f59e0b', '#6366f1', '#84cc16'
    ];
    
    // 1. Incident Trend Chart
    const trendCtx = document.getElementById('incidentTrendChart')?.getContext('2d');
    if (trendCtx) {
        const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: days,
                datasets: [{
                    label: 'Number of Incidents',
                    data: dailyCounts,
                    borderColor: '#f97316',
                    backgroundColor: 'rgba(249, 115, 22, 0.1)',
                    borderWidth: 3,
                    tension: 0.4,
                    fill: true,
                    pointBackgroundColor: '#f97316',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2,
                    pointRadius: 5,
                    pointHoverRadius: 7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { 
                        backgroundColor: '#1f2937',
                        titleColor: '#fff',
                        bodyColor: '#d1d5db'
                    }
                },
                scales: {
                    y: { 
                        beginAtZero: true,
                        grid: { color: '#e5e7eb' }
                    },
                    x: { grid: { display: false } }
                }
            }
        });
    }
    
    // 2. Incident Type Pie Chart
    console.log('typeCounts:', typeCounts);
    const typeCtx = document.getElementById('incidentTypeChart')?.getContext('2d');
    if (typeCtx) {
        new Chart(typeCtx, {
            type: 'doughnut',
            data: {
                labels: Object.keys(typeCounts),
                datasets: [{
                    data: Object.values(typeCounts),
                    backgroundColor: colors.slice(0, Object.keys(typeCounts).length),
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { 
                        position: 'bottom',
                        labels: { usePointStyle: true, boxWidth: 8 }
                    }
                },
                cutout: '60%'
            }
        });
    }
    
    // 3. Incident Status Chart
    const statusCtx = document.getElementById('incidentStatusChart')?.getContext('2d');
    if (statusCtx) {
        new Chart(statusCtx, {
            type: 'bar',
            data: {
                labels: Object.keys(statusCounts).map(s => s.charAt(0).toUpperCase() + s.slice(1)),
                datasets: [{
                    data: Object.values(statusCounts),
                    backgroundColor: ['#f97316', '#3b82f6', '#22c55e', '#ef4444'],
                    borderRadius: 6,
                    barPercentage: 0.7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: { 
                        beginAtZero: true,
                        grid: { color: '#e5e7eb' }
                    },
                    x: { grid: { display: false } }
                }
            }
        });
    }
    
    // 4. Hourly Distribution Chart
    const hourlyCtx = document.getElementById('hourlyDistributionChart')?.getContext('2d');
    if (hourlyCtx) {
        const hours = Array.from({length: 24}, (_, i) => i.toString().padStart(2, '0') + ':00');
        new Chart(hourlyCtx, {
            type: 'line',
            data: {
                labels: hours.filter((_, i) => i % 3 === 0), // Show every 3 hours
                datasets: [{
                    label: 'Incidents by Hour',
                    data: hourlyCounts,
                    borderColor: '#3b82f6',
                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                    borderWidth: 2,
                    tension: 0.4,
                    fill: true,
                    pointBackgroundColor: '#3b82f6'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: { 
                        beginAtZero: true,
                        grid: { color: '#e5e7eb' }
                    }
                }
            }
        });
    }
    
    // Chart period switching
    document.querySelectorAll('.chart-period-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.chart-period-btn').forEach(b => {
                b.classList.remove('active', 'bg-orange-600', 'text-white');
                b.classList.add('bg-gray-100', 'text-gray-600');
            });
            this.classList.add('active', 'bg-orange-600', 'text-white');
            this.classList.remove('bg-gray-100', 'text-gray-600');
            
            // Here you would fetch new data based on the period
            const period = this.dataset.period;
            console.log('Switching to', period, 'view');
            // You can make an AJAX call to get new data for the selected period
        });
    });
});
</script>

